# BrowserPier's settings for docker-compose.yml. Copy to .env and edit.
# Every BROWSERPIER_* setting is optional except where it says otherwise;
# see the full list in README.md.

# --- Reaching it ---------------------------------------------------------

# With Caddy (`docker compose --profile https up -d`): the domain pointing
# at this server. Caddy gets the certificate.
BROWSERPIER_DOMAIN=pier.example.com
# How people and agents reach BrowserPier: links and copied URLs use it,
# and an https URL makes cookies Secure.
BROWSERPIER_PUBLIC_URL=https://pier.example.com

# Where the app's port 7437 listens on this machine. 127.0.0.1 (the
# default) is for Caddy or your own proxy on this host; a Tailscale
# address (100.x.y.z) serves it on your tailnet only.
BROWSERPIER_BIND=127.0.0.1

# Live views (WebRTC) go straight to this server on port 7438, UDP with
# TCP as the fallback. Advertise the address viewers reach it at: the
# server's public IP, or its Tailscale IP. Comma-separated if several.
BROWSERPIER_WEBRTC_IPS=203.0.113.10

# --- Who runs it ---------------------------------------------------------

# Your user and group (`id -u`, `id -g`): ./data belongs to them.
PUID=1000
PGID=1000
# The Docker socket's group (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=999

# --- Optional ------------------------------------------------------------

# The admin password. Leave it unset to choose it on the first-run setup
# page instead (the setup code is in `docker compose logs browserpier`).
# Set here, it wins over one changed in the web UI, at every start.
#BROWSERPIER_ADMIN_PASSWORD=

# Share of the host's memory all browsers may use together (default 70).
# Set here, it can't be changed in Settings.
#BROWSERPIER_RAM_LIMIT_PERCENT=70

# A release, such as 1.0.0, instead of the latest.
#BROWSERPIER_VERSION=latest
