#!/usr/bin/env bash
# Before every start of the app, after a reboot too: loads BrowserPier's
# AppArmor profile (../apparmor/browserpier) into the kernel. On umbrelOS 2.0
# (Debian 13, AppArmor 4) Docker's own profile refuses Chromium's sandbox,
# so browsers run under this one instead: docker-default plus user
# namespaces. It isn't installed in /etc/apparmor.d: loaded here at each
# start, it can't outlive the app's own copy.
#
# Umbrel ignores a hook's exit status. If loading fails, BrowserPier finds
# the profile missing and runs browsers without AppArmor, as it did before
# it had a profile of its own, and its log says so.
set -euo pipefail

app="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
"${app}/apparmor/load"
